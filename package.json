{
  "name": "vscode-javascript-snippet",
  "publisher": "NicholasHsiang",
  "displayName": "JavaScript Code Snippet",
  "description": "Code snippets for JavaScript (ES3/5/6+) and TypeScript",
  "icon": "art/icon.png",
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "dark"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xianghongai/vscode-javascript-snippet/issues"
  },
  "homepage": "https://github.com/xianghongai/vscode-javascript-snippet/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xianghongai/vscode-javascript-snippet/blob/master/README.md"
  },
  "engines": {
    "node": ">=24",
    "vscode": "^1.0.0"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "JavaScript",
    "snippet",
    "代码",
    "代码片断",
    "snippets",
    "ES6 Snippets",
    "ES6+ Snippets",
    "Javascript Snippets",
    "JS Snippets",
    "ECMAScript Snippets",
    "TypeScript",
    "TS Snippets",
    "TypeScript Snippets"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/typescript.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/typescript.json"
      },
      {
        "language": "vue",
        "path": "./snippets/javascript.json"
      }
    ]
  },
  "scripts": {
    "format": "prettier --write --cache .",
    "dev": "nodemon --watch src -e json -x 'pnpm run prebuild'",
    "prebuild": "node main.js",
    "vscode:prepublish": "node main.js",
    "build": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vscode/vsce": "^3.9.2",
    "glob": "^13.0.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  }
}