{
  "name": "vscode-javascript-snippet",
  "displayName": "JavaScript Code Snippet",
  "version": "1.2.0",
  "description": "Code snippets for JavaScript (ES3/5/6+) and TypeScript",
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "ECMAScript Snippets",
    "ES6 Snippets",
    "ES6+ Snippets",
    "JS Snippets",
    "JavaScript",
    "Javascript Snippets",
    "TS Snippets",
    "TypeScript",
    "TypeScript Snippets",
    "snippet",
    "snippets",
    "代码",
    "代码片断"
  ],
  "homepage": "https://github.com/xianghongai/vscode-javascript-snippet/",
  "bugs": {
    "url": "https://github.com/xianghongai/vscode-javascript-snippet/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xianghongai/vscode-javascript-snippet/blob/master/README.md"
  },
  "publisher": "NicholasHsiang",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "clean": "rimraf --glob \"*.vsix\" snippets",
    "dev": "node --watch-path=src scripts/build.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint scripts tests",
    "test": "vitest run",
    "vsce:package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish --no-dependencies",
    "vscode:prepublish": "pnpm run clean && pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vscode/vsce": "^3.9.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.81.0",
    "picocolors": "^1.1.1",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.11"
  },
  "contributes": {
    "snippets": [
      {
        "path": "./snippets/index.code-snippets"
      }
    ]
  },
  "icon": "art/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@11.25.0"
}
